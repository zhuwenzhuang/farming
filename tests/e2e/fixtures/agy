#!/usr/bin/env bash
output_format=""
prev_arg=""
for arg in "$@"; do
  if [ "$arg" = "--version" ] || [ "$arg" = "-v" ]; then
    printf '1.3.5\n'
    exit 0
  fi
  if [ "$arg" = "--help" ] || [ "$arg" = "-h" ]; then
    printf 'Antigravity CLI - AI coding assistant\n'
    exit 0
  fi
  if [ "$prev_arg" = "--output-format" ]; then
    output_format="$arg"
  fi
  prev_arg="$arg"
done

if [ "$output_format" = "stream-json" ] || [ "$output_format" = "json" ]; then
  cat >/dev/null
  printf '{"event":"step_update","step_update":{"step_index":1,"step_type":"agent_response","state":"DONE","text_delta":"Antigravity ACP message handled"}}\n'
  printf '{"event":"result","result":{"status":"SUCCESS","response":"Antigravity ACP message handled"}}\n'
  exit 0
fi

printf 'Fake Antigravity ready\n'

while IFS= read -r line; do
  printf 'received: %s\n' "$line"
  printf 'Antigravity message handled\n'
done
