#!/usr/bin/env bash

if [[ "$#" -eq 6 && "$1" == "session" && "$2" == "list" && "$3" == "--format" \
  && "$4" == "json" && "$5" == "--max-count" && "$6" == "5000" ]]; then
  printf '[]\n'
  exit 0
fi

if [[ "$#" -eq 4 && "$1" == "export" && -n "$2" && "$3" == "--pure" && "$4" == "--sanitize" ]]; then
  printf '{}\n'
  exit 0
fi

printf 'Fake OpenCode ready\n'

while IFS= read -r line; do
  printf 'received: %s\n' "$line"
  printf 'OpenCode message handled\n'
done
