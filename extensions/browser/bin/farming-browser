const READ_ONLY_COMMANDS = new Set([
  'capability', 'list', 'tabs', 'snapshot', 'get', 'is',
]);
const IDEMPOTENT_COMMANDS = new Set([
  'capability', 'list', 'tabs', 'start', 'stop', 'snapshot', 'fill',
  'get', 'is', 'frame',
]);
const DESTRUCTIVE_COMMANDS = new Set([
  'stop', 'delete', 'eval', 'console', 'errors', 'network', 'cookies', 'storage',
]);
const CLOSED_WORLD_COMMANDS = new Set(['capability', 'list', 'tabs', 'stop', 'delete']);

function inputField(name, type, required = true, values) {
  return {
    name,
    type,
    required,
    ...(values ? { values } : {}),
  };
}

function commandInput(command) {
  const browserId = inputField('browser-id', 'string', false);
  const target = inputField('ref-or-css=selector', 'string');
  const timeout = inputField('--timeout', 'integer', false);
  if (command === 'capability') return { positionals: [], options: [] };
  if (command === 'list') return { positionals: [], options: [inputField('--workspace', 'path', false)] };
  if (command === 'tabs') return { positionals: [], options: [] };
  if (command === 'attach') return {
    positionals: [inputField('chrome-tab-id', 'integer')],
    options: [inputField('--session', 'string', false), inputField('--workspace', 'path', false), inputField('--name', 'string', false)],
  };
  if (command === 'open' || command === 'create') return {
    positionals: command === 'open' ? [inputField('url', 'http-url', false)] : [],
    options: [
      ...(command === 'open' ? [inputField('--session', 'string', false)] : []),
      inputField('--workspace', 'path', false),
      inputField('--name', 'string', false),
      inputField('--url', 'http-url', false),
      inputField('--source', 'enum', false, ['system', 'extension', 'isolated']),
      inputField('--executable', 'path', false),
    ],
  };
  if (['start', 'stop', 'delete', 'snapshot', 'screenshot', 'back', 'forward', 'reload'].includes(command)) {
    return { positionals: [browserId], options: [] };
  }
  if (command === 'navigate') return {
    positionals: [browserId, inputField('url', 'http-url')], options: [],
  };
  if (['click', 'dblclick', 'hover', 'focus', 'check', 'uncheck', 'scrollintoview', 'highlight'].includes(command)) {
    return { positionals: [browserId, target], options: [] };
  }
  if (command === 'fill' || command === 'type') return {
    positionals: [browserId, target, inputField('text', 'string')], options: [],
  };
  if (command === 'keyboard') return {
    positionals: [
      browserId,
      inputField('mode', 'enum', true, ['type', 'inserttext']),
      inputField('text', 'string'),
    ],
    options: [],
  };
  if (command === 'press') return {
    positionals: [browserId, inputField('key', 'string')], options: [],
  };
  if (command === 'select') return {
    positionals: [browserId, target, inputField('values', 'string[]')], options: [],
  };
  if (command === 'drag') return {
    positionals: [browserId, inputField('source', 'locator'), inputField('target', 'locator')], options: [],
  };
  if (command === 'scroll') return {
    positionals: [browserId, inputField('delta-y', 'number'), inputField('delta-x', 'number', false)],
    options: [],
  };
  if (command === 'wait') return {
    positionals: [browserId, inputField('condition', 'locator-or-milliseconds', false)],
    options: [
      inputField('--state', 'enum', false, ['visible', 'hidden', 'attached', 'detached']),
      inputField('--url', 'string', false), inputField('--load', 'enum', false, ['load', 'domcontentloaded', 'networkidle']),
      inputField('--text', 'string', false), inputField('--fn', 'javascript', false), timeout,
    ],
  };
  if (command === 'get') return {
    positionals: [
      browserId,
      inputField('what', 'enum', true, ['text', 'html', 'value', 'attr', 'title', 'url', 'count', 'box', 'styles']),
      inputField('target', 'locator', false), inputField('attribute', 'string', false),
    ],
    options: [],
  };
  if (command === 'is') return {
    positionals: [browserId, inputField('state', 'enum', true, ['visible', 'enabled', 'checked']), target], options: [],
  };
  if (command === 'find') return {
    positionals: [browserId, inputField('locator', 'string'), inputField('value', 'string'), inputField('action', 'string', false), inputField('text', 'string', false)],
    options: [inputField('--name', 'string', false), inputField('--exact', 'boolean', false)],
  };
  if (command === 'eval') return {
    positionals: [browserId, inputField('javascript-expression', 'javascript')], options: [],
  };
  if (command === 'console' || command === 'errors') return {
    positionals: [browserId], options: [inputField('--clear', 'boolean', false)],
  };
  if (command === 'network') return {
    positionals: [browserId, inputField('operation', 'enum', true, ['requests', 'request']), inputField('request-id', 'string', false)],
    options: [
      inputField('--filter', 'string', false), inputField('--type', 'string', false),
      inputField('--method', 'string', false), inputField('--status', 'string', false),
      inputField('--clear', 'boolean', false),
    ],
  };
  if (command === 'cookies') return {
    positionals: [browserId, inputField('operation', 'enum', true, ['get', 'set', 'clear']), inputField('name', 'string', false), inputField('value', 'string', false)],
    options: [
      inputField('--url', 'http-url', false), inputField('--domain', 'string', false), inputField('--path', 'string', false),
      inputField('--httpOnly', 'boolean', false), inputField('--secure', 'boolean', false),
      inputField('--sameSite', 'enum', false, ['Strict', 'Lax', 'None']), inputField('--expires', 'number', false),
    ],
  };
  if (command === 'storage') return {
    positionals: [
      browserId, inputField('storage', 'enum', true, ['local', 'session']),
      inputField('operation', 'enum', true, ['get', 'set', 'clear']),
      inputField('key', 'string', false), inputField('value', 'string', false),
    ],
    options: [],
  };
  if (command === 'frame') return {
    positionals: [browserId, inputField('main-or-locator', 'string')], options: [],
  };
  if (command === 'dialog') return {
    positionals: [browserId, inputField('operation', 'enum', true, ['status', 'accept', 'dismiss']), inputField('prompt-text', 'string', false)], options: [],
  };
  if (command === 'upload') return {
    positionals: [browserId, target, inputField('workspace-files', 'path[]')], options: [timeout],
  };
  if (command === 'download') return {
    positionals: [browserId, target, inputField('workspace-output', 'path')], options: [timeout],
  };
  return { positionals: [], options: [] };
}

function describeCommand(command) {
  if (!COMMAND_TOPICS[command]) throw new Error(`Unknown Browser command: ${command}`);
  return {
    version: 1,
    capability: 'browser',
    command,
    topic: COMMAND_TOPICS[command],
    summary: COMMAND_SUMMARIES[command],
    usage: commandUsage(command).trim(),
    input: {
      transport: 'argv',
      acceptsJsonStdin: false,
      defaultBrowserSession: 'default',
      ...commandInput(command),
    },
    annotations: {
      readOnly: READ_ONLY_COMMANDS.has(command),
      destructive: DESTRUCTIVE_COMMANDS.has(command),
      idempotent: IDEMPOTENT_COMMANDS.has(command),
      openWorld: !CLOSED_WORLD_COMMANDS.has(command),
      uncertainOnTransportFailure: !READ_ONLY_COMMANDS.has(command),
    },
    result: {
      envelope: true,
      media: command === 'screenshot' ? 'workspace-artifact' : 'none',
      maxCharacters: 100000,
    },
    failures: [
      'BROWSER_INVALID_REQUEST', 'BROWSER_INVALID_SESSION', 'BROWSER_NOT_FOUND', 'BROWSER_NOT_RUNNING',
      'BROWSER_STALE_GENERATION', 'BROWSER_OWNER_MISMATCH',
      'BROWSER_OWNER_NOT_RUNNING', 'CAPABILITY_COMMAND_FAILED',
    ],
    retryGuidance: READ_ONLY_COMMANDS.has(command)
      ? 'A bounded read may be retried after checking current capability and Resource state.'
      : 'If the response is lost or times out, observe current Browser state before retrying.',
  };
}

function commandUsage(command) {
  if (TOPIC_HELP[command]) return TOPIC_HELP[command];
  if (command === 'describe') return 'Usage: farming browser describe <command> --json\n';
  if (['capability', 'list', 'tabs', 'start', 'stop', 'delete', 'snapshot', 'screenshot', 'back', 'forward', 'reload'].includes(command)) {
    const suffix = command === 'list'
      ? '[--workspace <path>]'
      : (command === 'capability' || command === 'tabs' ? '' : '[browser-id] [--session <name>]');
    return `Usage: farming browser ${command}${suffix ? ` ${suffix}` : ''}\n`;
  }
  if (command === 'attach') {
    return `Usage: farming browser attach <chrome-tab-id> [--session <name>] [--workspace <path>] [--name <name>]

Binds the default or named Browser Session to an existing page from
\`farming browser tabs\`. Reuses the binding when it already targets that tab.
Stopping or deleting the Browser Resource leaves the user's Chrome tab open.
`;
  }
  if (command === 'open' || command === 'create') {
    return `Usage: farming browser ${command}${command === 'open' ? ' [url] [--session <name>]' : ''} [--workspace <path>] [--name <name>] [--url <url>] [--source <system|extension|isolated>]

${command === 'open'
    ? 'Opens the default or named Browser Session. It creates the Resource only when absent, starts it when stopped, and otherwise reuses it.'
    : 'Creates one stopped Project-scoped Browser Resource. Run start before page operations.'}

Use system for ordinary browser work, extension when the task needs the user's
current Chrome pages or sign-in state, and isolated for a separate environment.
Ordinary commands use the default Session when no Browser ID is supplied.
`;
  }
  if (command === 'navigate') {
    return 'Usage: farming browser navigate [browser-id] <http(s)-url>\n';
  }
  if (command === 'wait') {
    return `Usage:
  farming browser wait [browser-id] <ref-or-css=selector|milliseconds> [--state <visible|hidden|attached|detached>] [--timeout <ms>]
  farming browser wait [browser-id] --url <pattern> [--timeout <ms>]
  farming browser wait [browser-id] --load <load|domcontentloaded|networkidle> [--timeout <ms>]
  farming browser wait [browser-id] --text <text> [--timeout <ms>]
  farming browser wait [browser-id] --fn <javascript> [--timeout <ms>]
`;
  }
  if ([
    'click', 'dblclick', 'hover', 'focus', 'check', 'uncheck',
    'scrollintoview', 'highlight',
  ].includes(command)) {
    return `Usage: farming browser ${command} [browser-id] <ref-or-css=selector>\n`;
  }
  if (['fill', 'type'].includes(command)) {
    return `Usage: farming browser ${command} [browser-id] <ref-or-css=selector> <text>\n`;
  }
  if (command === 'keyboard') {
    return `Usage: farming browser keyboard [browser-id] <type|inserttext> <text>

Sends text to the currently focused element. Use this for contenteditable,
Monaco, CodeMirror, ProseMirror, and similar editors.
`;
  }
  if (command === 'press') return 'Usage: farming browser press [browser-id] <key>\n';
  if (command === 'select') {
    return 'Usage: farming browser select [browser-id] <ref-or-css=selector> <value...>\n';
  }
  if (command === 'drag') {
    return 'Usage: farming browser drag [browser-id] <source-ref-or-selector> <target-ref-or-selector>\n';
  }
  if (command === 'scroll') {
    return 'Usage: farming browser scroll [browser-id] <delta-y> [delta-x]\n';
  }
  if (command === 'get') {
    return `Usage:
  farming browser get [browser-id] <title|url>
  farming browser get [browser-id] <text|html|value|count|box|styles> <ref-or-css=selector>
  farming browser get [browser-id] attr <ref-or-css=selector> <attribute>
`;
  }
  if (command === 'is') {
    return 'Usage: farming browser is [browser-id] <visible|enabled|checked> <ref-or-css=selector>\n';
  }
  if (command === 'find') {
    return `Usage:
  farming browser find [browser-id] <role|text|label|placeholder|alt|title|testid|first|last> <value> [click|fill|type|hover|focus|check|uncheck] [text] [--name <name>] [--exact]
  farming browser find [browser-id] nth <index> <selector> [action] [text]
`;
  }
  if (command === 'eval') return 'Usage: farming browser eval [browser-id] <javascript-expression>\n';
  if (['console', 'errors'].includes(command)) {
    return `Usage: farming browser ${command} [browser-id] [--clear]\n`;
  }
  if (command === 'network') {
    return `Usage:
  farming browser network [browser-id] requests [--filter <pattern>] [--type <types>] [--method <method>] [--status <status>] [--clear]
  farming browser network [browser-id] request <request-id>
`;
  }
  if (command === 'cookies') {
    return `Usage:
  farming browser cookies [browser-id] <get|clear>
  farming browser cookies [browser-id] set <name> <value> [--url <url>] [--domain <domain>] [--path <path>] [--httpOnly] [--secure] [--sameSite <policy>] [--expires <unix-seconds>]
`;
  }
  if (command === 'storage') {
    return 'Usage: farming browser storage [browser-id] <local|session> <get|set|clear> [key] [value]\n';
  }
  if (command === 'frame') {
    return 'Usage: farming browser frame [browser-id] <main|ref-or-css=selector>\n';
  }
  if (command === 'dialog') {
    return 'Usage: farming browser dialog [browser-id] <status|accept|dismiss> [prompt-text]\n';
  }
  if (command === 'upload') {
    return `Usage: farming browser upload [browser-id] <ref-or-css=selector> <workspace-file...> [--timeout <ms>]

Every file must resolve inside the Browser Resource's Project workspace.
`;
  }
  if (command === 'download') {
    return `Usage: farming browser download [browser-id] <ref-or-css=selector> <workspace-output> [--timeout <ms>]

The output must stay inside the Browser Resource's Project workspace and must
not already exist.
`;
  }
  throw new Error(`Unknown Browser command: ${command}\n\n${usage()}`);
}

function locator(value) {
  return value.startsWith('css=') ? { selector: value.slice(4) } : { ref: value };
}

function option(args, name) {
  const index = args.indexOf(name);
  return index >= 0 ? args[index + 1] : undefined;
}

function hasFlag(args, name) {
  return args.includes(name);
}

function withoutOption(args, name) {
  const index = args.indexOf(name);
  if (index < 0) return [...args];
  if (!args[index + 1] || args[index + 1].startsWith('--')) {
    throw new Error(`${name} requires a value`);
  }
  return [...args.slice(0, index), ...args.slice(index + 2)];
}

function browserSessionArgv(argv) {
  const explicit = argv.includes('--session');
  const sessionName = option(argv, '--session') || 'default';
  if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(sessionName)) {
    throw new Error('Browser session must use 1-64 letters, numbers, dots, underscores, or hyphens');
  }
  return {
    argv: withoutOption(argv, '--session'),
    explicit,
    sessionName,
  };
}

function openUrl(args) {
  const explicit = option(args, '--url');
  if (explicit) return explicit;
  const valueOptions = new Set(['--workspace', '--name', '--url', '--source', '--executable']);
  for (let index = 0; index < args.length; index += 1) {
    if (valueOptions.has(args[index])) {
      index += 1;
      continue;
    }
    if (!args[index].startsWith('--')) return args[index];
  }
  return undefined;
}

function numberOption(args, name) {
  const value = option(args, name);
  return value === undefined ? undefined : Number(value);
}

function writeResult(operation, value, warnings = []) {
  writeCapabilityJson(process.stdout, capabilityEnvelope('browser', operation, value, warnings));
}

function browserExtensionPaths() {
  const configDir = farmingConfigDir(process.env);
  return {
    source: path.resolve(__dirname, '..', 'chrome-extension'),
    installed: browserExtensionPath(configDir),
    configDir,
  };
}

function boundWorkspace(requested, operation) {
  const agentWorkspace = String(process.env.FARMING_PROJECT_WORKSPACE || '').trim();
  const selected = String(requested || agentWorkspace).trim();
  if (!selected) return '';
  const workspace = canonicalWorkspacePath(selected);
  if (agentWorkspace && workspace !== canonicalWorkspacePath(agentWorkspace)) {
    throw new Error(`Browser ${operation} cannot leave this Agent Project workspace`);
  }
  return workspace;
}

async function requireProjectBrowser(id) {
  const requestedWorkspace = String(process.env.FARMING_PROJECT_WORKSPACE || '').trim();
  const requestedAgentId = String(process.env.FARMING_AGENT_ID || '').trim();
  if (!requestedWorkspace) return;
  const workspace = canonicalWorkspacePath(requestedWorkspace);
  const result = await requestJson('GET', '/api/browsers');
  const resource = (result.resources || []).find(item => (
    item?.id === id
    && (!requestedAgentId || item.ownerAgentId === requestedAgentId)
    && item.workspace
    && canonicalWorkspacePath(item.workspace) === workspace
  ));
  if (!resource) {
    throw new Error(`Browser Resource ${id} is not owned by this Agent`);
  }
}

function preferredLegacyResource(resources) {
  return [...resources].sort((left, right) => {
    const running = Number(['starting', 'running'].includes(right.status))
      - Number(['starting', 'running'].includes(left.status));
    return running || Number(right.updatedAt || 0) - Number(left.updatedAt || 0)
      || Number(left.createdAt || 0) - Number(right.createdAt || 0);
  })[0] || null;
}

async function resolveBrowserSession(sessionName) {
  const result = await requestJson('GET', '/api/browsers');
  const workspace = String(process.env.FARMING_PROJECT_WORKSPACE || '').trim();
  const agentId = String(process.env.FARMING_AGENT_ID || '').trim();
  const resources = (Array.isArray(result.resources) ? result.resources : []).filter(resource => (
    (!workspace || (
      resource.workspace
      && canonicalWorkspacePath(resource.workspace) === canonicalWorkspacePath(workspace)
    ))
    && (!agentId || resource.ownerAgentId === agentId)
  ));
  const exact = resources.filter(resource => resource.sessionName === sessionName);
  if (exact.length > 1) {
    throw new Error(`Browser session ${sessionName} has multiple Resources`);
  }
  if (exact[0]) return exact[0];
  if (sessionName === 'default') {
    const legacy = preferredLegacyResource(resources.filter(resource => !resource.sessionName));
    if (legacy) return legacy;
  }
  throw new Error(`Browser session ${sessionName} does not exist; run farming browser${sessionName === 'default' ? '' : ` --session ${sessionName}`} open`);
}

async function commandBrowserArgs(args, sessionName) {
  if (/^browser_[A-Za-z0-9_-]+$/.test(String(args[0] || ''))) {
    await requireProjectBrowser(args[0]);
    return args;
  }
  const resource = await resolveBrowserSession(sessionName);
  return [resource.id, ...args];
}

async function run(argv = process.argv.slice(2)) {
  const parsed = browserSessionArgv(argv);
  const [command, ...rawArgs] = parsed.argv;
  let args = rawArgs;
  const sessionName = parsed.sessionName;
  if (!command || command === '--help') {
    process.stdout.write(usage());
    return 0;
  }
  if (command === 'help') {
    process.stdout.write(args[0] ? commandUsage(args[0]) : usage());
    return 0;
  }
  if (args.includes('--help')) {
    process.stdout.write(commandUsage(command));
    return 0;
  }
  if (command === 'describe') {
    const described = args[0];
    if (!described) throw new Error('Usage: farming browser describe <command> --json');
    writeResult('describe', describeCommand(described));
    return 0;
  }
  if (command === 'extension') {
    const operation = args[0] || 'status';
    const paths = browserExtensionPaths();
    if (operation === 'path') {
      const extensionPath = ensureBrowserExtensionLink(paths.source, paths.configDir);
      process.stdout.write(`${extensionPath}\n`);
      return 0;
    }
    if (operation === 'pair') {
      const result = await requestJson('GET', '/api/browsers/extension');
      process.stdout.write(`${result.pairingString || ''}\n`);
      return 0;
    }
    if (operation === 'status') {
      writeResult('extension-status', await requestJson('GET', '/api/browsers/extension'));
      return 0;
    }
    throw new Error('Usage: farming browser extension <path|pair|status>');
  }
  if (command === 'capability') {
    const result = await requestJson('GET', '/api/browsers/capability');
    writeResult(command, result);
    return 0;
  }
  if (command === 'tabs') {
    writeResult(command, await requestJson('GET', '/api/browsers/extension/tabs'));
    return 0;
  }
  if (command === 'attach') {
    const workspace = boundWorkspace(option(args, '--workspace'), command);
    if (!workspace) {
      throw new Error('Browser attach requires --workspace or FARMING_PROJECT_WORKSPACE');
    }
    let result = await requestJson('POST', '/api/browsers', {
      rootId: rootIdForPath(workspace),
      agentId: process.env.FARMING_AGENT_ID || undefined,
      name: option(args, '--name') || undefined,
      source: 'extension',
      existingTabId: args[0],
      sessionName,
      reuseSession: true,
    });
    result = await requestJson('POST', `/api/browsers/${encodeURIComponent(result.id)}/start`);
    writeResult(command, result);
    return 0;
  }
  if (command === 'create' || command === 'open') {
    if (command === 'create' && parsed.explicit) {
      throw new Error('Browser create does not bind a Session; use browser open with --session instead');
    }
    const workspace = boundWorkspace(option(args, '--workspace'), command);
    if (!workspace) {
      throw new Error('Browser create requires --workspace or FARMING_PROJECT_WORKSPACE');
    }
    const requestedUrl = command === 'open' ? openUrl(args) : option(args, '--url');
    let result = await requestJson('POST', '/api/browsers', {
      rootId: rootIdForPath(workspace),
      agentId: process.env.FARMING_AGENT_ID || undefined,
      name: option(args, '--name') || undefined,
      source: option(args, '--source') || undefined,
      executablePath: option(args, '--executable') || undefined,
      url: requestedUrl || undefined,
      ...(command === 'open' ? { sessionName, reuseSession: true } : {}),
    });
    if (command === 'open') {
      const needsNavigation = result.sessionNeedsNavigation === true;
      result = await requestJson('POST', `/api/browsers/${encodeURIComponent(result.id)}/start`);
      if (needsNavigation && requestedUrl) {
        result = await requestJson('POST', `/api/browsers/${encodeURIComponent(result.id)}/action`, {
          kind: 'navigate',
          url: requestedUrl,
        });
      }
    }
    writeResult(command, result);
    return 0;
  }
  if (command === 'list') {
    const workspaceIndex = args.indexOf('--workspace');
    const requestedWorkspace = workspaceIndex >= 0
      ? args[workspaceIndex + 1] || ''
      : process.env.FARMING_PROJECT_WORKSPACE || '';
    const workspace = boundWorkspace(requestedWorkspace, command);
    const result = await requestJson('GET', '/api/browsers');
    const resources = workspace
      ? result.resources.filter(resource => (
        canonicalWorkspacePath(resource.workspace) === workspace
        && (
          !process.env.FARMING_AGENT_ID
          || resource.ownerAgentId === process.env.FARMING_AGENT_ID
        )
      ))
      : result.resources;
    writeResult(command, { resources });
    return 0;
  }
  args = await commandBrowserArgs(args, sessionName);
  const id = args[0];
  if (command === 'start' || command === 'stop') {
    const result = await requestJson('POST', `/api/browsers/${encodeURIComponent(id)}/${command}`);
    writeResult(command, result);
    return 0;
  }
  if (command === 'delete') {
    const result = await requestJson('DELETE', `/api/browsers/${encodeURIComponent(id)}`);
    writeResult(command, result);
    return 0;
  }
  let action;
  if (command === 'snapshot') action = { kind: 'snapshot' };
  else if (command === 'navigate') action = { kind: 'navigate', url: args[1] };
  else if (['back', 'forward', 'reload'].includes(command)) action = { kind: command };
  else if (command === 'click') action = { kind: 'click', ...locator(args[1] || '') };
  else if ([
    'dblclick',
    'hover',
    'focus',
    'check',
    'uncheck',
    'scrollintoview',
    'highlight',
  ].includes(command)) {
    action = { kind: command, ...locator(args[1] || '') };
  }
  else if (command === 'fill' || command === 'type') {
    action = { kind: command, ...locator(args[1] || ''), text: args.slice(2).join(' ') };
  } else if (command === 'keyboard') {
    action = { kind: 'keyboard', mode: args[1], text: args.slice(2).join(' ') };
  } else if (command === 'press') action = { kind: 'press', key: args[1] };
  else if (command === 'select') {
    action = { kind: 'select', ...locator(args[1] || ''), values: args.slice(2) };
  } else if (command === 'drag') {
    const source = locator(args[1] || '');
    const target = locator(args[2] || '');
    action = {
      kind: 'drag',
      sourceRef: source.ref,
      sourceSelector: source.selector,
      targetRef: target.ref,
      targetSelector: target.selector,
    };
  } else if (command === 'upload') {
    const timeoutIndex = args.indexOf('--timeout');
    const files = args.slice(2, timeoutIndex >= 0 ? timeoutIndex : undefined);
    action = {
      kind: 'upload',
      ...locator(args[1] || ''),
      files: files.map(file => path.resolve(file)),
      timeoutMs: numberOption(args, '--timeout'),
    };
  } else if (command === 'download') {
    action = {
      kind: 'download',
      ...locator(args[1] || ''),
      path: path.resolve(args[2] || ''),
      timeoutMs: numberOption(args, '--timeout'),
    };
  } else if (command === 'wait') {
    const waitModes = [
      ['--url', 'url'],
      ['--load', 'load'],
      ['--fn', 'function'],
      ['--text', 'text'],
    ];
    const selected = waitModes.find(([flag]) => option(args, flag) !== undefined);
    if (selected) {
      action = {
        kind: 'wait',
        mode: selected[1],
        value: option(args, selected[0]),
        timeoutMs: numberOption(args, '--timeout'),
      };
    } else if (/^\d+$/.test(String(args[1] || ''))) {
      action = {
        kind: 'wait',
        mode: 'time',
        durationMs: Number(args[1]),
        timeoutMs: numberOption(args, '--timeout'),
      };
    } else {
      action = {
        kind: 'wait',
        mode: 'selector',
        ...locator(args[1] || ''),
        state: option(args, '--state'),
        timeoutMs: numberOption(args, '--timeout'),
      };
    }
  } else if (command === 'get') {
    action = { kind: 'get', what: args[1] };
    if (!['title', 'url'].includes(args[1])) Object.assign(action, locator(args[2] || ''));
    if (args[1] === 'attr') action.attribute = args[3];
  } else if (command === 'is') {
    action = { kind: 'is', state: args[1], ...locator(args[2] || '') };
  } else if (command === 'find') {
    const nth = args[1] === 'nth';
    action = {
      kind: 'find',
      locator: args[1],
      ...(nth
        ? { index: Number(args[2]), value: args[3], action: args[4], text: args[5] }
        : { value: args[2], action: args[3], text: args[4] }),
      name: option(args, '--name'),
      exact: hasFlag(args, '--exact'),
    };
  } else if (command === 'eval') {
    action = { kind: 'eval', expression: args.slice(1).join(' ') };
  } else if (command === 'console' || command === 'errors') {
    action = { kind: command, clear: hasFlag(args, '--clear') };
  } else if (command === 'network') {
    action = {
      kind: 'network',
      operation: args[1] || 'requests',
      requestId: args[2],
      filter: option(args, '--filter'),
      resourceType: option(args, '--type'),
      method: option(args, '--method'),
      status: option(args, '--status'),
      clear: hasFlag(args, '--clear'),
    };
  } else if (command === 'cookies') {
    action = {
      kind: 'cookies',
      operation: args[1] || 'get',
      name: args[2],
      value: args[3],
      url: option(args, '--url'),
      domain: option(args, '--domain'),
      path: option(args, '--path'),
      httpOnly: hasFlag(args, '--httpOnly'),
      secure: hasFlag(args, '--secure'),
      sameSite: option(args, '--sameSite'),
      expires: option(args, '--expires'),
    };
  } else if (command === 'storage') {
    action = {
      kind: 'storage',
      storageType: args[1],
      operation: args[2] || 'get',
      key: args[3],
      value: args.slice(4).join(' '),
    };
  } else if (command === 'frame') {
    action = args[1] === 'main'
      ? { kind: 'frame', main: true }
      : { kind: 'frame', ...locator(args[1] || '') };
  } else if (command === 'dialog') {
    action = { kind: 'dialog', operation: args[1] || 'status', text: args.slice(2).join(' ') || undefined };
  }
  else if (command === 'scroll') {
    action = { kind: 'scroll', deltaY: Number(args[1]) || 0, deltaX: Number(args[2]) || 0 };
  } else if (command === 'screenshot') action = { kind: 'screenshot' };
  else {
    throw new Error(`Unknown command: ${command}\n\n${usage()}`);
  }
  const result = await requestJson('POST', `/api/browsers/${encodeURIComponent(id)}/action`, action);
  writeResult(command, result);
  return 0;
}

async function main(argv = process.argv.slice(2)) {
  try {
    return await run(argv);
  } catch (error) {
    const operation = String(argv[0] === '--session' ? argv[2] : argv[0] || 'help');
    if (/timed out/i.test(String(error?.message || error)) && !READ_ONLY_COMMANDS.has(operation)) {
      error.uncertain = true;
    }
    writeCapabilityJson(
      process.stderr,
      capabilityError(error, 'browser', operation),
    );
    process.exitCode = 1;
    return 1;
  }
}

if (require.main === module) {
  void main();
}

module.exports = {
  COMMAND_TOPICS,
  describeCommand,
  main,
  run,
};
