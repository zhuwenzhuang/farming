#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const { requestJson } = require('../backend/farming-browser-client');

function usage() {
  return `Usage:
  farming-browser list [--workspace <path>]
  farming-browser start <browser-id>
  farming-browser stop <browser-id>
  farming-browser snapshot <browser-id>
  farming-browser navigate <browser-id> <url>
  farming-browser click <browser-id> <ref-or-selector>
  farming-browser fill <browser-id> <ref-or-selector> <text>
  farming-browser type <browser-id> <ref-or-selector> <text>
  farming-browser press <browser-id> <key>
  farming-browser scroll <browser-id> <delta-y> [delta-x]
  farming-browser screenshot <browser-id> <output.png>

Element refs come from snapshot. Prefix a CSS selector with "css=".
`;
}

function locator(value) {
  return value.startsWith('css=') ? { selector: value.slice(4) } : { ref: value };
}

async function run(argv = process.argv.slice(2)) {
  const [command, ...args] = argv;
  if (!command || command === '--help' || command === 'help') {
    process.stdout.write(usage());
    return 0;
  }
  if (command === 'mcp') {
    const { runBrowserMcpServer } = require('../backend/browser-mcp-server');
    await runBrowserMcpServer();
    return 0;
  }
  if (command === 'list') {
    const workspaceIndex = args.indexOf('--workspace');
    const workspace = workspaceIndex >= 0 ? path.resolve(args[workspaceIndex + 1] || '') : '';
    const result = await requestJson('GET', '/api/browsers');
    const resources = workspace
      ? result.resources.filter(resource => path.resolve(resource.workspace) === workspace)
      : result.resources;
    process.stdout.write(`${JSON.stringify({ resources }, null, 2)}\n`);
    return 0;
  }
  const id = args[0];
  if (!id) throw new Error(`Browser id is required\n\n${usage()}`);
  if (command === 'start' || command === 'stop') {
    const result = await requestJson('POST', `/api/browsers/${encodeURIComponent(id)}/${command}`);
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
    return 0;
  }
  let action;
  if (command === 'snapshot') action = { kind: 'snapshot' };
  else if (command === 'navigate') action = { kind: 'navigate', url: args[1] };
  else if (command === 'click') action = { kind: 'click', ...locator(args[1] || '') };
  else if (command === 'fill' || command === 'type') {
    action = { kind: command, ...locator(args[1] || ''), text: args.slice(2).join(' ') };
  } else if (command === 'press') action = { kind: 'press', key: args[1] };
  else if (command === 'scroll') {
    action = { kind: 'scroll', deltaY: Number(args[1]) || 0, deltaX: Number(args[2]) || 0 };
  } else if (command === 'screenshot') {
    const output = path.resolve(args[1] || 'farming-browser.png');
    const result = await requestJson('POST', `/api/browsers/${encodeURIComponent(id)}/action`, { kind: 'screenshot' });
    fs.writeFileSync(output, Buffer.from(result.data, 'base64'));
    process.stdout.write(`${output}\n`);
    return 0;
  } else {
    throw new Error(`Unknown command: ${command}\n\n${usage()}`);
  }
  const result = await requestJson('POST', `/api/browsers/${encodeURIComponent(id)}/action`, action);
  process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  return 0;
}

if (require.main === module) {
  run().catch(error => {
    process.stderr.write(`${error.message}\n`);
    process.exitCode = 1;
  });
}

module.exports = {
  run,
};
