{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "backend/**/*.ts",
    "backend/types/**/*.d.ts"
  ],
  "exclude": [
    "backend/tests/**",
    "backend/usage-history-scanner.ts"
  ]
}
