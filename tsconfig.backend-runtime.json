{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "backend/**/*.cts",
    "backend/types/**/*.d.ts",
    "extensions/browser/backend/**/*.cts",
    "extensions/computer/backend/**/*.cts"
  ],
  "exclude": [
    "backend/tests/**",
    "backend/vendor/**"
  ]
}
